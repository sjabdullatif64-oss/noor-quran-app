<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base app theme — dark green, no action bar -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#1a5c38</item>
        <item name="colorPrimaryDark">#071a0e</item>
        <item name="colorAccent">#1a5c38</item>
        <item name="android:windowBackground">#071a0e</item>
        <item name="android:statusBarColor">#071a0e</item>
        <item name="android:navigationBarColor">#071a0e</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Activity content theme — no action bar, draws system bar backgrounds -->
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <!-- Launch/splash theme: shown during cold start before WebView is ready.
         MUST extend an AppCompat-compatible theme so that AppCompatActivity
         (BridgeActivity's ancestor) does not throw "You need to use a
         Theme.AppCompat theme" when super.onCreate() is called.
         Theme.SplashScreen from core-splashscreen 1.2.0 extends Material3 which
         requires com.google.android.material — we do NOT have that dependency, so
         we must NOT extend Theme.SplashScreen here.
         android:windowBackground shows the splash drawable in the window before
         setContentView() runs; SplashScreen.installSplashScreen() handles the
         API-31+ platform splash transition regardless of the parent theme. -->
    <style name="AppTheme.Launcher" parent="AppTheme.NoActionBar">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>
</resources>
